# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Postgres. Locally these are the same string.
#
# On a managed provider that pools connections (Supabase, Neon), DATABASE_URL is
# the POOLED endpoint and DIRECT_URL is the direct one. Migrations need a real
# session, which a transaction-mode pooler cannot give them.
#
#   Supabase pooled : postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   Supabase direct : postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://apex:apex@127.0.0.1:5432/apex_trading?schema=public"
DIRECT_URL="postgresql://apex:apex@127.0.0.1:5432/apex_trading?schema=public"

# Public origin of the deployment. Drives canonical URLs, sitemap, OG images.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 32+ random bytes. Generate with: openssl rand -base64 48
# Signs session cookies. Rotating this logs everyone out.
AUTH_SECRET="change-me-openssl-rand-base64-48"

# Seed credentials for the first administrator (used by `npm run db:seed`).
SEED_ADMIN_EMAIL="admin@axiomcapital.example"
SEED_ADMIN_PASSWORD="ChangeMe!2024"

# ---------------------------------------------------------------------------
# Market data (all optional — the platform falls back to cached/seeded quotes)
# ---------------------------------------------------------------------------

# CoinGecko: works without a key on the public tier, rate limited to ~10 req/min.
COINGECKO_API_KEY=""

# Equity quotes. Get a free key at finnhub.io or twelvedata.com.
FINNHUB_API_KEY=""
TWELVEDATA_API_KEY=""

# ---------------------------------------------------------------------------
# Deposit instructions shown to investors (manual settlement flow)
# ---------------------------------------------------------------------------
DEPOSIT_BANK_NAME="Axiom Capital Client Money Account"
DEPOSIT_BANK_IBAN="GB00 XXXX 0000 0000 0000 00"
DEPOSIT_BANK_SWIFT="XXXXGB2L"
DEPOSIT_BTC_ADDRESS=""
DEPOSIT_ETH_ADDRESS=""
DEPOSIT_USDT_TRC20_ADDRESS=""
